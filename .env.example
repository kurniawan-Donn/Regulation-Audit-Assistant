# Application settings
APP_NAME=Regulation to IT Audit Assistant
APP_ENV=development
DEBUG=true

# Server & keamanan
# Default hanya dari komputer ini. Untuk akses jaringan: isi APP_PASSWORD + pasang HTTPS.
HOST=127.0.0.1
PORT=8000
APP_USERNAME=auditor
APP_PASSWORD=

# AI Provider (akan digunakan mulai Phase 4)
# Dapatkan API key dari https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=8192
# Jarak minimum antar-request ke Gemini (detik) - jaga RPM free tier
GEMINI_MIN_SECONDS_BETWEEN_REQUESTS=4.5

# Phase 11: batching - budget karakter maksimum gabungan chunk per 1 request AI
MAX_CHARS_PER_BATCH=6000

# Upload settings
MAX_UPLOAD_SIZE_MB=20

# Background jobs: jumlah analisis AI yang boleh berjalan bersamaan (sisanya antre)
MAX_CONCURRENT_JOBS=1
